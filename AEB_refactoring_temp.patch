+  if (publish_debug_pointcloud_ && points && !points->empty()) {
+    const auto ros_pointcloud = std::make_shared<PointCloud2>();
+    pcl::toROSMsg(*points, *ros_pointcloud);
+    pub_obstacle_pointcloud_->publish(*ros_pointcloud);
+  }
+}
